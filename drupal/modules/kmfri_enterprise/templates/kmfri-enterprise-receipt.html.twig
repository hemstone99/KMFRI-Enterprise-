{#
/**
 * @file
 * Confirmation of a registered quotation request (shown once, from the session).
 */
#}
{% set title %}Inquiry Successfully <em>Registered</em>{% endset %}
{% include '@kmfri_enterprise/partials/banner.html.twig' with {
  crumbs: [{label: 'Home'|t, url: path('kmfri_enterprise.home')}, {label: 'Request a Quotation'|t, url: path('kmfri_enterprise.quote')}, {label: 'Confirmation'|t}],
  title: title,
  image: 'images/analytical-lab.webp',
  image_position: 'center 40%',
  next: '#F7F9FC',
} only %}

<section class="band-mist k-section pt-8! pb-[calc(var(--wave-h)+3rem)]!">
  <div class="k-container max-w-3xl!">
    <div class="k-panel p-6 sm:p-8 space-y-6 text-center" role="status" aria-live="polite">
      <span class="grid place-items-center w-16 h-16 mx-auto rounded-full bg-teal-50 text-teal-700 ring-8 ring-teal-50/60">{{ kmfri_icon('circle-check', 'w-9 h-9') }}</span>
      <div class="space-y-2">
        <h2 class="k-h3 text-xl!">{{ 'Inquiry Successfully Registered'|t }}</h2>
        <p class="text-[0.95rem] text-muted max-w-md mx-auto">Your enterprise request has been logged into the KMFRI Service Delivery System. An official pro-forma invoice and technical instructions will be dispatched to your email.</p>
      </div>

      <dl class="max-w-md mx-auto text-left text-sm rounded-xl border border-line bg-canvas overflow-hidden">
        <div class="flex justify-between gap-4 px-4 py-3 bg-navy-800 text-white">
          <dt class="font-semibold tracking-wide">OFFICIAL REFERENCE</dt>
          <dd class="font-mono font-semibold text-teal-400">{{ receipt.reference }}</dd>
        </div>
        {% for row in [
          ['Service:', receipt.service],
          ['Pricing Tier:', receipt.tier ?: 'To be quoted'],
          ['Estimated Units:', receipt.units],
          ['Status:', receipt.status|replace({'_': ' '})],
        ] %}
          <div class="flex justify-between gap-4 px-4 py-2 border-b border-line">
            <dt class="text-muted shrink-0">{{ row[0] }}</dt>
            <dd class="font-medium text-ink text-right">{{ row[1] }}</dd>
          </div>
        {% endfor %}
        <div class="flex justify-between gap-4 px-4 py-2.5 border-b border-line bg-white">
          <dt class="font-semibold text-navy-800">Indicative Fee:</dt>
          <dd class="k-num">{{ receipt.estimated_cost_kes > 0 ? 'KES ' ~ receipt.estimated_cost_kes|kes : 'Issued on quotation' }}</dd>
        </div>
        <div class="flex justify-between gap-4 px-4 py-2 border-b border-line">
          <dt class="text-muted">Station:</dt>
          <dd class="text-right">{{ receipt.station ?: '—' }}</dd>
        </div>
        <div class="flex justify-between gap-4 px-4 py-2">
          <dt class="text-muted">Contact Email:</dt>
          <dd class="text-right break-all">{{ receipt.email }}</dd>
        </div>
      </dl>

      <div class="flex flex-col-reverse sm:flex-row items-center justify-center gap-3">
        <a href="{{ path('kmfri_enterprise.quote') }}" class="btn btn-outline btn-sm">{{ 'New Request'|t }}</a>
        <button type="button" class="btn btn-outline btn-sm" data-kmfri-print>{{ kmfri_icon('printer') }} {{ 'Print Receipt'|t }}</button>
        <a href="{{ kmfri_service_url(receipt.service_slug) }}" class="btn btn-primary btn-sm">{{ 'Return to Service'|t }}</a>
      </div>
    </div>
  </div>
</section>
