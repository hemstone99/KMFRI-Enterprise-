{#
/**
 * @file
 * One research station: overview and contacts, every catalogue service offered there
 * (grouped by division, each division collapsible), and booking. "Get a quote" links carry
 * the station (?station=) so the quotation names it as the preferred centre.
 *
 * Variables:
 * - station: station record plus slug, short_name, address, image, tel, map_url.
 * - offer: {divisions (each with sections), other, total, online}.
 * - others: other stations [{name, url}].
 * - quote_query: {station: id} for quotation links; quote_url: quotation form for this station.
 * - ecitizen_url.
 */
#}
{% import '@kmfri_enterprise/partials/macros.html.twig' as k %}

{% set banner_extra %}
  <div class="mt-6 flex flex-wrap gap-3">
    <a class="btn btn-teal" href="#station-services">{{ kmfri_icon('calendar-check') }} {{ 'Book a service'|t }}</a>
    <a class="btn btn-ghost-light" href="{{ quote_url }}">{{ 'Request a quotation'|t }}</a>
    <a class="btn btn-ghost-light" href="{{ station.map_url }}" target="_blank" rel="noopener noreferrer">{{ kmfri_icon('navigation') }} {{ 'Directions'|t }}</a>
  </div>
{% endset %}
{% include '@kmfri_enterprise/partials/banner.html.twig' with {
  crumbs: [{label: 'Home'|t, url: path('kmfri_enterprise.home')}, {label: 'Research Stations'|t, url: path('kmfri_enterprise.stations')}, {label: station.name}],
  title: station.name,
  subtitle: station.address,
  image: station.image,
  image_position: 'center 50%',
  next: '#F7F9FC',
  extra: banner_extra,
} only %}

<section class="band-mist k-section pt-6!" aria-label="{{ station.name }} overview and services">
  <div class="k-container space-y-8">

    {# Overview #}
    <section class="k-panel overflow-hidden grid lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]" aria-labelledby="station-overview">
      <div class="p-5 sm:p-7">
        <div class="flex flex-wrap items-center gap-2">
          <span class="k-tag">{{ 'Overview'|t }}</span>
          <span class="k-badge k-badge--teal k-badge--mono">{{ station.code }}</span>
        </div>
        <h2 id="station-overview" class="k-h3 mt-2">What happens at {{ station.short_name }}</h2>
        <p class="mt-3 text-[1.0125rem] leading-relaxed text-ink">{{ station.description }}</p>
        {% if station.primary_focus %}
          <h3 class="k-tag mt-6 mb-2.5">{{ 'Facilities & focus'|t }}</h3>
          <ul class="flex flex-wrap gap-1.5">
            {% for f in station.primary_focus %}<li class="k-chip">{{ f }}</li>{% endfor %}
          </ul>
        {% endif %}
        <dl class="mt-6 grid grid-cols-3 gap-px bg-line rounded-xl overflow-hidden border border-line">
          {% for f in [{label: 'Service areas'|t, value: offer.divisions|length}, {label: 'Services'|t, value: offer.total}, {label: 'Apply online'|t, value: offer.online}] %}
            <div class="bg-white p-3 sm:p-4">
              <dt class="text-[0.7rem] font-semibold uppercase tracking-widest text-subtle">{{ f.label }}</dt>
              <dd class="k-num text-xl mt-0.5">{{ f.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
      <div class="bg-canvas border-t lg:border-t-0 lg:border-l border-line p-5 sm:p-7 space-y-4 text-sm">
        <h3 class="k-tag">{{ 'Contact the station'|t }}</h3>
        <p class="flex items-start gap-2.5">
          {{ kmfri_icon('user', 'w-4 h-4 text-teal-700 shrink-0 mt-0.5') }}
          <span><span class="block text-xs text-subtle">{{ 'Head of station'|t }}</span><span class="font-semibold text-navy-800">{{ station.head_of_station }}</span></span>
        </p>
        <a href="tel:{{ station.tel }}" class="flex items-center gap-2.5 text-ink hover:text-navy-600">{{ kmfri_icon('phone', 'w-4 h-4 text-teal-700 shrink-0') }} {{ station.phone }}</a>
        <a href="mailto:{{ station.contact_email }}" class="flex items-center gap-2.5 text-navy-600 font-medium hover:underline break-all">{{ kmfri_icon('mail', 'w-4 h-4 text-teal-700 shrink-0') }} {{ station.contact_email }}</a>
        <a href="{{ station.map_url }}" target="_blank" rel="noopener noreferrer" class="flex items-start gap-2.5 text-ink hover:text-navy-600">
          {{ kmfri_icon('map-pin', 'w-4 h-4 text-teal-700 shrink-0 mt-0.5') }}
          <span>{{ station.address }}<span class="block text-xs text-navy-600 font-semibold mt-0.5">{{ 'Open in Google Maps'|t }}</span></span>
        </a>
        <div class="pt-2 flex flex-wrap gap-2">
          <a href="#station-services" class="btn btn-primary btn-sm">{{ kmfri_icon('calendar-check') }} {{ 'Book a service'|t }}</a>
          {% if offer.online %}<a href="{{ ecitizen_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">eCitizen {{ kmfri_icon('external-link') }}</a>{% endif %}
        </div>
      </div>
    </section>

    {# Services offered here #}
    <section id="station-services" class="scroll-mt-32 space-y-5" aria-labelledby="station-services-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="k-eyebrow">{{ 'Services & Booking'|t }}</span>
          <h2 id="station-services-heading" class="k-h2">Services at this <em>station</em></h2>
          <p class="text-muted mt-2 max-w-2xl">
            {{ offer.total }} {{ offer.total == 1 ? 'service' : 'services' }} in {{ offer.divisions|length }} areas. Apply online where available, or request a quotation — your request names {{ station.short_name }} as the preferred centre.
          </p>
        </div>
        {% if offer.divisions|length > 1 %}
          <ul class="flex flex-wrap gap-2" aria-label="{{ 'Jump to a service area'|t }}">
            {% for d in offer.divisions %}
              <li><a href="#station-{{ d.id }}" class="k-tab min-h-8.5! py-1! px-3! text-[0.8125rem]! bg-white!">{{ k.division_icon(d.id, 'w-4 h-4') }} {{ d.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% if not offer.divisions %}
        <div class="k-panel p-8 text-center text-muted">{{ 'Services for this station are being listed. Call @phone or request a quotation.'|t({'@phone': station.phone}) }}</div>
      {% endif %}

      {% for d in offer.divisions %}
        <details id="station-{{ d.id }}" class="group k-panel overflow-hidden scroll-mt-32"{% if loop.first %} open{% endif %}>
          <summary class="cursor-pointer list-none flex flex-wrap items-center gap-4 p-4 sm:p-5 [&::-webkit-details-marker]:hidden">
            <span class="grid place-items-center w-11 h-11 shrink-0 rounded-xl bg-teal-50 text-teal-700 border border-[#bfe8ec]">{{ k.division_icon(d.id) }}</span>
            <span class="flex-1 min-w-[12rem]">
              <span class="block font-heading font-semibold text-lg text-navy-800">{{ d.title }}</span>
              <span class="block text-sm text-muted">{{ d.tagline }}</span>
            </span>
            <span class="text-sm font-semibold text-teal-800">
              {{ d.count }} {{ d.count == 1 ? 'service' : 'services' }}{% if d.from_kes is not null %} · from Ksh {{ d.from_kes|kes }}{% endif %}{% if d.online %} · {{ d.online }} online{% endif %}
            </span>
            {{ kmfri_icon('chevron-down', 'w-5 h-5 text-subtle transition-transform group-open:rotate-180') }}
          </summary>
          <div class="border-t border-line bg-canvas p-3 sm:p-4 space-y-4">
            {% for s in d.sections %}
              {% include '@kmfri_enterprise/partials/catalogue-section.html.twig' with {s: s, show_intro: false, ecitizen_url: ecitizen_url, quote_query: quote_query} only %}
            {% endfor %}
            <a class="k-link text-sm" href="{{ kmfri_catalogue_url(d.path) }}">About {{ d.title }}: requirements, turnaround &amp; contacts {{ kmfri_icon('arrow-right', 'w-4 h-4') }}</a>
          </div>
        </details>
      {% endfor %}

      {% if offer.other %}
        <div class="k-panel p-5 flex flex-wrap items-center justify-between gap-4">
          <div>
            <h3 class="k-tag">{{ 'Also available on request'|t }}</h3>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {% for o in offer.other %}<li class="k-chip">{{ o }}</li>{% endfor %}
            </ul>
          </div>
          <a class="btn btn-outline btn-sm" href="{{ quote_url }}">{{ 'Request a quotation'|t }}</a>
        </div>
      {% endif %}
    </section>

    {# Other stations #}
    {% if others %}
      <nav aria-label="{{ 'Other research stations'|t }}" class="pt-2">
        <h2 class="k-tag mb-3">{{ 'Other research stations'|t }}</h2>
        <ul class="flex flex-wrap gap-2">
          {% for o in others %}
            <li><a href="{{ o.url }}" class="k-tab min-h-9! py-1! px-3.5! text-[0.8125rem]! bg-white!">{{ kmfri_icon('map-pin') }} {{ o.name }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</section>

{% set title %}Book a service at <em>{{ station.short_name }}</em>{% endset %}
{% embed '@kmfri_enterprise/partials/cta.html.twig' with {eyebrow: station.code, title: title, text: 'Send your sample list, quantities or visit dates and the station will confirm availability with an official KMFRI quotation.'|t} %}
  {% block actions %}
    <a class="btn btn-teal" href="{{ quote_url }}">{{ 'Request a Quotation'|t }}</a>
    <a class="btn btn-ghost-light" href="tel:{{ station.tel }}">{{ kmfri_icon('phone') }} {{ 'Call the station'|t }}</a>
  {% endblock %}
{% endembed %}
