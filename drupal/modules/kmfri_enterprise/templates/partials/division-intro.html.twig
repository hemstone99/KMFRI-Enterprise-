{#
/**
 * @file
 * Division introduction: what the service is, why KMFRI, photos and key facts; who it is
 * for, how to get it and whom to contact; research fleet, datasets and indicative packages.
 *
 * Variables:
 * - division: catalogue division (tagline, highlight, benefits, credentials, gallery, counts).
 * - service: services-database portfolio record, or NULL when unavailable.
 * - packages: portfolio pricing tiers (only where the register lists no tariffs).
 * - stations_here: stations offering the division [{name, url}].
 * - quote_url, ecitizen_url.
 */
#}
{% set gallery = division.gallery|slice(0, 3) %}
{% set facts = [{label: 'Services'|t, value: division.count ~ ' in this division', icon: 'clipboard-list'}] %}
{% if division.from_kes is not null %}
  {% set facts = facts|merge([{label: 'Prices from'|t, value: 'Ksh ' ~ division.from_kes|kes, icon: 'receipt'}]) %}
{% else %}
  {% set facts = facts|merge([{label: 'Pricing'|t, value: 'On official quotation'|t, icon: 'receipt'}]) %}
{% endif %}
{% if service and service.turnaround_time %}
  {% set facts = facts|merge([{label: 'Turnaround'|t, value: service.turnaround_time|split('(')|first|trim, icon: 'clock'}]) %}
{% endif %}
{% set facts = facts|merge([{label: 'Apply online'|t, value: division.online ? division.online ~ ' on eCitizen' : 'Request via KMFRI'|t, icon: 'external-link'}]) %}

<div class="space-y-6">
  {# Overview, benefits and photos #}
  <section class="k-panel overflow-hidden" aria-labelledby="division-about">
    <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <div class="p-5 sm:p-7">
        <span class="k-tag">{{ 'About this service'|t }}</span>
        <h2 id="division-about" class="k-h3 mt-1">{{ division.tagline }}</h2>
        <p class="mt-3 text-[1.0125rem] leading-relaxed text-ink">{{ division.highlight }}</p>
        <h3 class="k-tag mt-6 mb-3">{{ 'Why choose KMFRI'|t }}</h3>
        <ul class="space-y-2.5">
          {% for b in division.benefits %}
            <li class="k-check text-[0.95rem]">{{ kmfri_icon('circle-check') }}<span>{{ b }}</span></li>
          {% endfor %}
        </ul>
        {% if division.credentials %}
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="{{ 'Quality credentials'|t }}">
            {% for c in division.credentials %}
              <li class="k-badge k-badge--navy">{{ kmfri_icon('badge-check', 'w-3.5 h-3.5') }} {{ c }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      <div class="grid grid-cols-2 gap-1 bg-line{{ gallery|length > 1 ? ' lg:grid-rows-[3fr_2fr]' : '' }}">
        {% for g in gallery %}
          {% set wide = loop.first or (gallery|length == 2 and loop.index == 2) %}
          <img src="{{ loop.first ? kmfri_asset(g.src) : kmfri_small(g.src) }}"{% if loop.first and kmfri_srcset(g.src) %} srcset="{{ kmfri_srcset(g.src) }}" sizes="(min-width: 1024px) 520px, 100vw"{% endif %} alt="{{ g.alt }}" loading="lazy" class="w-full h-full object-cover {{ wide ? 'col-span-2 aspect-[16/9]' : 'aspect-[4/3]' }} lg:aspect-auto lg:min-h-[140px]">
        {% endfor %}
      </div>
    </div>
    <dl class="grid grid-cols-2 {{ facts|length == 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' }} gap-px bg-line border-t border-line max-lg:[&>:last-child:nth-child(odd)]:col-span-2">
      {% for f in facts %}
        <div class="flex items-start gap-3 p-4 sm:p-5 bg-white">
          {{ kmfri_icon(f.icon, 'w-5 h-5 text-teal-700 shrink-0 mt-0.5') }}
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-widest text-subtle">{{ f.label }}</dt>
            <dd class="mt-0.5 font-semibold text-navy-800 leading-snug">{{ f.value }}</dd>
          </div>
        </div>
      {% endfor %}
    </dl>
  </section>

  {# Who it is for · how to get it · contact #}
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {% if service and service.target_clients %}
      <section class="k-panel" aria-labelledby="division-clients">
        <div class="k-panel__head">{{ kmfri_icon('users', 'w-5 h-5') }}<h3 id="division-clients">{{ 'Who it is for'|t }}</h3></div>
        <ul class="k-panel__body space-y-2 text-[0.95rem]">
          {% for c in service.target_clients %}
            <li class="k-check">{{ kmfri_icon('circle-check') }}<span>{{ c }}</span></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <section class="k-panel" aria-labelledby="division-howto">
      <div class="k-panel__head">{{ kmfri_icon('clipboard-list', 'w-5 h-5') }}<h3 id="division-howto">{{ 'How to get it'|t }}</h3></div>
      {% set steps = [division.online ? 'Choose a service below and apply online on eCitizen, or request a quotation for anything else.'|t : 'Choose a service below and request an official quotation.'|t] %}
      {% set steps = steps|merge(service.sample_requirements ?? [])|merge(['Pay electronically and receive your official KMFRI receipt.'|t]) %}
      <ol class="k-panel__body space-y-3 text-[0.95rem]">
        {% for step in steps %}
          <li class="flex items-start gap-3">
            <span class="grid place-items-center w-6 h-6 shrink-0 rounded-full bg-navy-600 text-white text-xs font-semibold font-heading">{{ loop.index }}</span>
            <span class="leading-relaxed">{{ step }}</span>
          </li>
        {% endfor %}
      </ol>
    </section>

    <section class="k-panel md:col-span-2 xl:col-span-1" aria-labelledby="division-contact">
      <div class="k-panel__head">{{ kmfri_icon('phone', 'w-5 h-5') }}<h3 id="division-contact">{{ 'Talk to KMFRI'|t }}</h3></div>
      <div class="k-panel__body space-y-3 text-sm">
        {% if service %}
          <p class="font-semibold text-navy-800">{{ service.contact_officer.title }}</p>
          <a href="mailto:{{ service.contact_officer.email }}" class="flex items-center gap-2 text-navy-600 font-medium hover:underline break-all">{{ kmfri_icon('mail', 'w-4 h-4 text-teal-700 shrink-0') }} {{ service.contact_officer.email }}</a>
        {% endif %}
        {# The published inquiries desk number is shown for every service. #}
        <a href="tel:+25441475151" class="flex items-center gap-2 text-ink hover:text-navy-600">{{ kmfri_icon('phone', 'w-4 h-4 text-teal-700 shrink-0') }} +254 (0) 41 475151</a>
        {% if stations_here %}
          <div class="flex items-start gap-2">
            {{ kmfri_icon('map-pin', 'w-4 h-4 text-teal-700 shrink-0 mt-0.5') }}
            <div>
              <span class="block text-xs text-subtle">{{ 'Where to get it'|t }}</span>
              <ul class="flex flex-wrap gap-x-3 gap-y-1">
                {% for st in stations_here %}<li><a href="{{ st.url }}" class="text-navy-600 font-medium hover:underline">{{ st.name }}</a></li>{% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
        <div class="flex flex-wrap gap-2 pt-2">
          {% if division.service_slug %}<a href="{{ quote_url }}" class="btn btn-primary btn-sm">{{ 'Request a quotation'|t }}</a>{% endif %}
          {% if division.online %}<a href="{{ ecitizen_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">eCitizen {{ kmfri_icon('external-link') }}</a>{% endif %}
        </div>
      </div>
    </section>
  </div>

  {# Research fleet #}
  {% if service and service.vessels %}
    <section class="k-panel" aria-labelledby="fleet-heading">
      <div class="k-panel__head">{{ kmfri_icon('ship', 'w-5 h-5') }}<h3 id="fleet-heading">{{ 'Research fleet available for charter'|t }}</h3></div>
      <div class="k-panel__body">
        <div class="k-table-wrap">
          <table class="k-table min-w-[720px]">
            <caption class="sr-only">{{ 'KMFRI research vessels and charter rates'|t }}</caption>
            <thead><tr><th scope="col">{{ 'Vessel'|t }}</th><th scope="col">{{ 'Specification'|t }}</th><th scope="col">{{ 'Scientific gear'|t }}</th><th scope="col">{{ 'Day rate'|t }}</th></tr></thead>
            <tbody>
              {% for v in service.vessels %}
                <tr>
                  <td>
                    <span class="block font-semibold text-navy-800">{{ v.name }}</span>
                    <span class="block text-xs text-muted">{{ v.home_port }}</span>
                    <span class="k-badge mt-1.5 {{ v.status == 'available' ? 'k-badge--teal' : 'k-badge--gold' }}">{{ v.status|replace({'_': ' '}) }}</span>
                  </td>
                  <td class="text-sm text-muted whitespace-nowrap">
                    {{ v.length_metres }} m · {{ v.gross_tonnage }} GT<br>
                    {{ v.cruise_speed_knots }} kn cruise · {{ v.endurance_days }} day{{ v.endurance_days == 1 ? '' : 's' }} endurance<br>
                    {{ v.scientist_berths }} scientist berths
                  </td>
                  <td class="text-sm text-ink max-w-[280px]">{{ v.gear }}</td>
                  <td><span class="k-num">Ksh {{ v.rate_kes|kes }}</span></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {% endif %}

  {# KeNODC datasets #}
  {% if service and service.datasets %}
    <section class="k-panel" aria-labelledby="datasets-heading">
      <div class="k-panel__head">{{ kmfri_icon('database', 'w-5 h-5') }}<h3 id="datasets-heading">{{ 'Datasets available on request'|t }}</h3></div>
      <div class="k-panel__body">
        <div class="k-table-wrap">
          <table class="k-table min-w-[720px]">
            <caption class="sr-only">{{ 'Curated scientific datasets with standard and academic tariffs'|t }}</caption>
            <thead><tr><th scope="col">{{ 'Dataset'|t }}</th><th scope="col">{{ 'Coverage & resolution'|t }}</th><th scope="col">{{ 'Format'|t }}</th><th scope="col">{{ 'Tariff'|t }}</th></tr></thead>
            <tbody>
              {% for d in service.datasets %}
                <tr>
                  <td><span class="block font-semibold text-navy-800">{{ d.title }}</span><span class="block font-mono text-xs text-subtle">{{ d.code }} · {{ d.curating_centre }}</span></td>
                  <td class="text-sm text-muted">{{ d.coverage }}<br>{{ d.resolution }} · {{ d.temporal_range }}</td>
                  <td class="text-sm text-ink whitespace-nowrap">{{ d.format }}</td>
                  <td><span class="k-num">Ksh {{ d.tariff_kes|kes }}</span><span class="block text-xs text-subtle mt-0.5">Academic: Ksh {{ d.academic_kes|kes }}</span></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {% endif %}

  {# Indicative packages where the register lists no tariff #}
  {% if packages %}
    <section class="k-panel" aria-labelledby="packages-heading">
      <div class="k-panel__head flex-wrap justify-between">
        <div class="flex items-center gap-2.5">{{ kmfri_icon('receipt', 'w-5 h-5') }}<h3 id="packages-heading">{{ 'Indicative packages'|t }}</h3></div>
        <span class="text-xs text-subtle">{{ 'Confirmed on your official quotation'|t }}</span>
      </div>
      <ul class="divide-y divide-line">
        {% for p in packages %}
          <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5">
            <div class="min-w-0">
              <p class="font-semibold text-navy-800">{{ p.name }}</p>
              <p class="text-xs text-muted">{{ p.unit }}{% if p.turnaround_time %} · {{ p.turnaround_time }}{% endif %}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="k-num">Ksh {{ p.cost_kes|kes }}</span>
              <a href="{{ path('kmfri_enterprise.quote', {}, {'query': {'service': division.service_slug, 'tier': p.id}}) }}" class="btn btn-outline btn-sm">{{ 'Get a quote'|t }}<span class="sr-only"> for {{ p.name }}</span></a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if not service and division.service_slug %}
    <p class="k-alert k-alert--note text-sm">{{ kmfri_icon('info') }}<span>{{ 'Full service details are temporarily unavailable. Call +254 (0) 41 475151 for assistance.'|t }}</span></p>
  {% endif %}
</div>
