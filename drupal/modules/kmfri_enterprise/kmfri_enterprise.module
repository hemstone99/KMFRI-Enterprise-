<?php

/**
 * @file
 * KMFRI Commercial & Enterprise Services Hub.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function kmfri_enterprise_help(string $route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.kmfri_enterprise') {
    return '<p>' . t('The Enterprise Services Hub publishes the KMFRI commercial service catalogue, tariffs, research stations and laboratory services under <a href=":url">/enterprise</a>, and records quotation requests in kmfri_services_db.', [':url' => '/enterprise']) . '</p>';
  }
  return NULL;
}

