/**
 * Implements hook_menu_links_discovered_alter().
 *
 * The hub's Home link (kmfri_enterprise.home) replaces the Standard install
 * profile's front-page link, which would otherwise appear twice in Main navigation.
 */
function kmfri_enterprise_menu_links_discovered_alter(array &$links): void {
  unset($links['standard.front_page']);
}
