# Copy to .env.local and fill in.
# --- Database (MySQL 8.0+ / MariaDB 10.4+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kmfri_services_db
# Application account the API connects with (created by `npm run db:setup`)
DB_USER=kmfri_hub
DB_PASSWORD=change-me
# Admin account used only by `npm run db:setup` to build the schema and grant privileges
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# --- API server ---
API_PORT=4000
